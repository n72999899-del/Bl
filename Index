  <!-- ================= JAVASCRIPT & SERVICE WORKER ================= -->
  <script>
    // 1. Registro de Service Worker embebido mediante Blob para soporte PWA Offline
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        const swScript = `
          const CACHE_NAME = 'bluecalves-cache-v1';
          self.addEventListener('install', (e) => self.skipWaiting());
          self.addEventListener('activate', (e) => clients.claim());
          self.addEventListener('fetch', (e) => {
            e.respondWith(
              fetch(e.request).catch(() => caches.match(e.request))
            );
          });
        `;
        const blob = new Blob([swScript], { type: 'application/javascript' });
        navigator.serviceWorker.register(URL.createObjectURL(blob)).catch(() => {});
      });
    }

    // Instalación PWA (BeforeInstallPrompt)
    let deferredPrompt;
    window.addEventListener('beforeinstallprompt', (e) => {
      e.preventDefault();
      deferredPrompt = e;
      const installBtn = document.getElementById('install-btn');
      if (installBtn) installBtn.classList.remove('hidden');
    });

    function installPWA() {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        deferredPrompt.userChoice.then(() => {
          deferredPrompt = null;
          document.getElementById('install-btn').classList.add('hidden');
        });
      }
    }

    // 2. Navegación entre Vistas (Single Page Experience)
    function navigateTo(tabId) {
      const tabs = ['home', 'overload', 'macros', 'arena'];
      tabs.forEach(tab => {
        const screen = document.getElementById(`tab-${tab}`);
        const navBtn = document.getElementById(`nav-${tab}`);
        
        if (tab === tabId) {
          screen.classList.remove('hidden');
          navBtn.classList.remove('text-slate-400');
          navBtn.classList.add('text-brand-cyan');
        } else {
          screen.classList.add('hidden');
          navBtn.classList.add('text-slate-400');
          navBtn.classList.remove('text-brand-cyan');
        }
      });
      window.scrollTo(0, 0);
    }

    // 3. Sistema de Sobrecarga Progresiva (Persistencia LocalStorage)
    let lifts = JSON.parse(localStorage.getItem('bluecalves_lifts') || '[]');

    function updateDashboardCount() {
      const el = document.getElementById('home-sets-count');
      if (el) el.innerText = lifts.length;
    }

    function renderLifts() {
      const container = document.getElementById('lifts-container');
      updateDashboardCount();

      if (lifts.length === 0) {
        container.innerHTML = `
          <div class="text-center py-8 text-slate-500 text-xs border border-dashed border-brand-border rounded-xl">
            No tienes registros todavía. Guarda tu primer set arriba.
          </div>`;
        return;
      }

      container.innerHTML = lifts.map((item, index) => `
        <div class="bg-brand-card border border-brand-border/80 p-3.5 rounded-2xl flex items-center justify-between shadow-md">
          <div>
            <h4 class="font-bold text-sm text-white capitalize">${item.exercise}</h4>
            <div class="flex items-center gap-2 mt-0.5 text-xs text-slate-400">
              <span class="text-brand-cyan font-extrabold">${item.weight} kg</span>
              <span>×</span>
              <span class="text-white font-bold">${item.reps} reps</span>
              ${item.rpe ? `<span class="text-[10px] bg-brand-darker px-1.5 py-0.5 rounded border border-brand-border">RPE ${item.rpe}</span>` : ''}
            </div>
          </div>
          <div class="flex items-center gap-3">
            <span class="text-[10px] text-slate-500 font-semibold">${item.date}</span>
            <button onclick="deleteLift(${index})" class="text-slate-500 hover:text-rose-400 transition p-1">
              ✕
            </button>
          </div>
        </div>
      `).join('');
    }

    function addLift(e) {
      e.preventDefault();
      const exercise = document.getElementById('exercise-name').value.trim();
      const weight = document.getElementById('exercise-weight').value;
      const reps = document.getElementById('exercise-reps').value;
      const rpe = document.getElementById('exercise-rpe').value;

      if (!exercise || !weight || !reps) return;

      const newLift = {
        exercise,
        weight,
        reps,
        rpe,
        date: new Date().toLocaleDateString('es-ES', { day: '2-digit', month: 'short' })
      };

      lifts.unshift(newLift);
      localStorage.setItem('bluecalves_lifts', JSON.stringify(lifts));
      renderLifts();
      document.getElementById('overload-form').reset();
    }

    function deleteLift(index) {
      lifts.splice(index, 1);
      localStorage.setItem('bluecalves_lifts', JSON.stringify(lifts));
      renderLifts();
    }

    function clearHistory() {
      if (confirm('¿Deseas reiniciar tu historial de sobrecarga?')) {
        lifts = [];
        localStorage.removeItem('bluecalves_lifts');
        renderLifts();
      }
    }

    // 4. Calculadora de Macros (Mifflin-St Jeor + Superávit/Déficit)
    function calculateMacros() {
      const weight = parseFloat(document.getElementById('macro-weight').value);
      const height = parseFloat(document.getElementById('macro-height').value);
      const age = parseFloat(document.getElementById('macro-age').value);
      const activity = parseFloat(document.getElementById('macro-activity').value);
      const goal = document.getElementById('macro-goal').value;

      if (isNaN(weight) || isNaN(height) || isNaN(age)) return;

      // TMB Fórmula Mifflin-St Jeor (varón deportivo)
      const tmb = (10 * weight) + (6.25 * height) - (5 * age) + 5;
      const tdee = tmb * activity;

      let surplus = 0;
      if (goal === 'bulk_clean') surplus = 300;
      if (goal === 'bulk_hard') surplus = 500;
      if (goal === 'cut') surplus = -400;

      const totalCalories = Math.round(tdee + surplus);

      // Desglose de macronutrientes: 2.0g/kg Proteína, 0.9g/kg Grasa, resto Carbohidratos
      const proteinGrams = Math.round(weight * 2.0);
      const fatsGrams = Math.round(weight * 0.9);
      const calFromProtAndFat = (proteinGrams * 4) + (fatsGrams * 9);
      const carbsGrams = Math.max(0, Math.round((totalCalories - calFromProtAndFat) / 4));

      document.getElementById('res-cals').innerText = `${totalCalories} KCAL`;
      document.getElementById('res-prot').innerText = `${proteinGrams}g`;
      document.getElementById('res-carb').innerText = `${carbsGrams}g`;
      document.getElementById('res-fats').innerText = `${fatsGrams}g`;
    }

    // 5. Utilidad de Copiado Rápido al Portapapeles
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        alert('Copiado al portapapeles: ' + text);
      }).catch(() => {
        prompt('Copia manualmente:', text);
      });
    }

    // Inicializaciones al arrancar
    document.addEventListener('DOMContentLoaded', () => {
      renderLifts();
      calculateMacros();
    });
  </script>
